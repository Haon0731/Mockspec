(set-logic ALL)
(declare-fun from1_present () Bool)
(declare-fun from2_present () Bool)
(declare-fun version_null () Bool)
(declare-fun version_throws () Bool)
(declare-fun version () Int)
(declare-fun version_called () Bool)
(declare-fun image_observation_reached () Bool)
(declare-fun java8_selected () Bool)
(declare-fun external_image_matches () Bool)
(assert (>= version (- 2147483648)))
(assert (<= version 2147483647))
(assert (= version_called (not from1_present)))
(assert (= image_observation_reached (and version_called (not version_null) (not version_throws))))
(assert (= java8_selected (and image_observation_reached (<= version 8))))
(assert (not from1_present))
(assert (and (not version_null) (not version_throws) (<= version 8)))
