(set-logic ALL)
(declare-fun custom_empty () Bool)
(declare-fun custom_matches () Bool)
(declare-fun computed_matches () Bool)
(declare-fun entrypoint_matches () Bool)
(declare-fun entrypoint_observation_reached () Bool)
(assert (=> custom_empty (not custom_matches)))
(assert (= entrypoint_observation_reached true))
(assert (= entrypoint_matches (and entrypoint_observation_reached (ite custom_empty computed_matches custom_matches))))
(assert true)
(assert (and (not custom_empty) custom_matches))
