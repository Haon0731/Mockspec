(set-logic ALL)
(declare-fun ctx_none () Bool)
(declare-fun abort_throws () Bool)
(declare-fun abort_message_matches () Bool)
(declare-fun fallback_throws () Bool)
(declare-fun fallback_message_matches () Bool)
(declare-fun abort_called () Bool)
(declare-fun fallback_called () Bool)
(declare-fun exception_observed () Bool)
(declare-fun message_observed_matches () Bool)
(assert (= abort_called (not ctx_none)))
(assert (= fallback_called (or ctx_none (not abort_throws))))
(assert (= exception_observed (or (and abort_called abort_throws) (and fallback_called fallback_throws))))
(assert (= message_observed_matches (or (and abort_called abort_throws abort_message_matches) (and fallback_called fallback_throws fallback_message_matches))))
(assert true)
(assert (and (not ctx_none) abort_throws abort_message_matches))
