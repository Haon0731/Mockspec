{
  "scope": "synthetic process isolation probes only",
  "probes": {
    "parse_error": {
      "failure": {
        "diagnostic": "Symbol 'missing_symbol' not declared as a variable",
        "status": "parse_error",
        "locally_sufficient": false,
        "whole_test_verified": false
      },
      "host_survived": true,
      "subsequent_check": "unsat",
      "subsequent_check_sufficient": true
    },
    "crash": {
      "failure": {
        "status": "native_crash",
        "locally_sufficient": false,
        "whole_test_verified": false,
        "diagnostic": "local solver worker terminated by SIGSEGV",
        "exit_code": -11
      },
      "host_survived": true,
      "subsequent_check": "unsat",
      "subsequent_check_sufficient": true
    },
    "hang": {
      "failure": {
        "status": "timeout",
        "locally_sufficient": false,
        "whole_test_verified": false,
        "diagnostic": "local solver worker exceeded its wall-clock limit"
      },
      "host_survived": true,
      "subsequent_check": "unsat",
      "subsequent_check_sufficient": true
    },
    "output": {
      "failure": {
        "status": "output_limit",
        "locally_sufficient": false,
        "whole_test_verified": false,
        "diagnostic": "local solver worker exceeded its output limit"
      },
      "host_survived": true,
      "subsequent_check": "unsat",
      "subsequent_check_sufficient": true
    },
    "memory": {
      "failure": {
        "diagnostic": "local solver worker rejected the request",
        "locally_sufficient": false,
        "status": "worker_error",
        "whole_test_verified": false
      },
      "host_survived": true,
      "subsequent_check": "unsat",
      "subsequent_check_sufficient": true
    },
    "worker_error": {
      "failure": {
        "diagnostic": "local solver worker rejected the request",
        "locally_sufficient": false,
        "status": "worker_error",
        "whole_test_verified": false
      },
      "host_survived": true,
      "subsequent_check": "unsat",
      "subsequent_check_sufficient": true
    }
  }
}
